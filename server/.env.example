NODE_ENV=development
PORT=5000

# Generate with: openssl rand -base64 48
JWT_SECRET=
# Or mount a secret and set JWT_SECRET_FILE=/run/secrets/jwt_secret
JWT_ISSUER=medical-image-annotation-api
JWT_AUDIENCE=medical-image-annotation-client
JWT_EXPIRES_IN=8h

MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=annotationApp
# Container alternative: MONGO_HOST, MONGO_USER, and MONGO_PASSWORD_FILE

CLIENT_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false
ENFORCE_HTTPS=false

JSON_BODY_LIMIT=25mb
MAX_UPLOAD_FILE_BYTES=1048576000
MAX_UPLOAD_FILES=2000
UPLOADS_ROOT=

API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=2000
AUTH_RATE_LIMIT_MAX=20
AUDIT_RETENTION_DAYS=365

# Generate exactly 32 bytes with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# Or mount a secret and set DATA_ENCRYPTION_KEY_FILE=/run/secrets/data_encryption_key

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Or mount a secret and set GOOGLE_CLIENT_SECRET_FILE=/run/secrets/google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/google-drive/callback
