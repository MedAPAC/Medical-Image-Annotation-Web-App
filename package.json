{
  "name": "medical-image-annotation-web-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix client && npm install --prefix server",
    "client": "npm start --prefix client",
    "server": "npm run dev --prefix server",
    "build": "npm run build --prefix client",
    "start": "npm start --prefix server",
    "check:server": "npm test --prefix server",
    "test:client": "npm run test:ci --prefix client",
    "docker:env": "node scripts/generate-docker-env.js",
    "docker:config": "docker compose --env-file .env.docker config",
    "docker:build": "docker compose --env-file .env.docker build",
    "docker:up": "docker compose --env-file .env.docker up -d",
    "docker:down": "docker compose --env-file .env.docker down"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
