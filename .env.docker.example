APP_PORT=3000
PUBLIC_APP_URL=http://localhost:3000
ENFORCE_HTTPS=false

MONGO_DB_NAME=annotationApp
MONGO_ROOT_USER=medical_root
MONGO_ROOT_PASSWORD=replace-with-a-long-random-base64url-secret
MONGO_APP_USER=medical_app
MONGO_APP_PASSWORD=replace-with-a-different-long-random-base64url-secret

JWT_SECRET=replace-with-at-least-32-random-characters
DATA_ENCRYPTION_KEY=replace-with-exactly-32-bytes-encoded-as-base64

AUDIT_RETENTION_DAYS=365
MAX_UPLOAD_FILE_BYTES=1048576000
MAX_UPLOAD_FILES=2000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=disabled
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google-drive/callback

# Set these to published image names to pull instead of building locally.
SERVER_IMAGE=medical-image-annotation-server:local
CLIENT_IMAGE=medical-image-annotation-client:local
